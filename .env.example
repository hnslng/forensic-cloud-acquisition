# Phase 0: database infrastructure only; no web application is deployed yet.
# Copy to /etc/fca/compose.env, outside the checkout, after VM approval.
FCA_STATE_ROOT=/var/lib/fca
FCA_POSTGRES_PASSWORD_FILE=/etc/fca/secrets/postgres_password
FCA_API_PASSWORD_FILE=/etc/fca/secrets/api_password
FCA_EVIDENCE_ROOT=/srv/fca/evidence
FCA_PUBLIC_ORIGIN=https://VM_PRIVATE_IP
